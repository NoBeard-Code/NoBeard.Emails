@page "/sendmail"

@using NoBeard.Emails.Web.Models
@using NoBeard.Emails.Web.Services

@inject EmailService EmailService

<PageTitle>Send e-mail</PageTitle>

<h1>Send e-mail</h1>

<div class="mb-3">
    <label for="to">To:</label>
    <input id="to" class="form-control" @bind="To" />
</div>

<div class="mb-3">
    <label for="subject">Subject:</label>
    <input id="subject" class="form-control" @bind="Subject" />
</div>

<div class="mb-3">
    <label for="body">Body:</label>
    <textarea id="body" class="form-control" rows="5" @bind="Body"></textarea>
</div>

<button class="btn btn-primary" @onclick="SendViaSmtpAsync">Send via SMTP</button>
<button class="btn btn-primary" @onclick="SendViaAcsAsync">Send via ACS</button>

<p class="mt-3 text-info">@StatusMessage</p>

@if (!string.IsNullOrEmpty(MessageId))
{
    <p class="mt-2 text-success">Message ID: @MessageId</p>
}

@code {
    private string To { get; set; } = "ratko@gdwinnovations.be";
    private string Subject { get; set; } = "Test e-mail";
    private string Body { get; set; } = "This is a test mail";
    private string StatusMessage { get; set; } = string.Empty;
    private string MessageId { get; set; } = string.Empty;

    private async Task SendViaSmtpAsync()
    {
        try
        {
            var mail = new Mail()
            {
                Tos = new List<string> { To },
                Subject = Subject,
                Body = Body,
                CreatedOn = DateTime.UtcNow
            };

            var msg = await EmailService.SendViaSmtpAsync(mail);

            StatusMessage = "✅ Mail sent successfully!";
            MessageId = msg.MessageId ?? "Not found";
        }
        catch (Exception ex)
        {
            StatusMessage = $"❌ Error: {ex.Message}";
            return;
        }
    }

    private async Task SendViaAcsAsync()
    {
        try
        {
            var mail = new Mail()
            {
                Tos = new List<string> { To },
                Subject = Subject,
                Body = Body,
                CreatedOn = DateTime.UtcNow
            };

            var msg = await EmailService.SendViaAcsAsync(mail);

            StatusMessage = "✅ Mail sent successfully!";
            MessageId = msg.MessageId ?? "Not found";
        }
        catch (Exception ex)
        {
            StatusMessage = $"❌ Error: {ex.Message}";
            return;
        }
    }
}
